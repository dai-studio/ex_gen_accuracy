<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:dai="https://dai.studio/schema/dai/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" name="moxy" targetNamespace="https://dai.studio/workflow">
  <bpmn:process id="Process_1" name="moxy" isExecutable="false">
    <bpmn:extensionElements>
      <dai:workflowMeta description="Moxy: a locally run gateway server written in Rust that sits between callers (developers, admins and AI agents) and one or more AI model endpoints. It loads its routes from moxy.xml (Moxy Markup Language), applies per-route middleware to requests and responses, and forwards traffic to configured upstream URLs. It also serves built-in routes for endpoint discovery (/), a chat UI (/chat), administration (/admin), authentication (/auth) and a JSON API (/api). Persistent state lives in one embedded key-value store organised with Single Table Design. Decisions taken to remove ambiguity from v0.1.0 are recorded in the &#39;decisions&#39; and &#39;assumptions&#39; containers." targetLanguage="Rust" targetFramework="Pingora (proxy), SvelteKit (web UI)" version="0.1.0">
        <dai:taskTypeEntry stepType="" description="A generic work item or activity in the process flow." />
        <dai:taskTypeEntry type="dai.types.software.dependency" stepType="dependency" description="An external library, toolchain or package Moxy is built with, with its version policy, license and purpose." />
        <dai:taskTypeEntry type="dai.types.product.persona" stepType="persona" description="A kind of caller of the Moxy server (developer, admin, agent), with its role, goals and how it authenticates." />
        <dai:taskTypeEntry type="dai.types.software.service" stepType="service" description="The running Moxy server process and its startup, shutdown and error conventions." />
        <dai:taskTypeEntry type="dai.types.software.api-endpoint" stepType="api-endpoint" description="A route Moxy exposes: method, path, required auth and behaviour." />
        <dai:taskTypeEntry type="dai.types.software.model" stepType="model" description="A record stored in the KV store: its fields and key format." />
        <dai:taskTypeEntry type="dai.types.software.decision" description="A design decision that resolves an ambiguity in the original spec. Proposed = awaiting owner confirmation." />
        <dai:taskTypeEntry type="dai.types.business.assumption" stepType="assumption" description="An interpretation of the original author&#39;s intent that the spec relies on." />
      </dai:workflowMeta>
    </bpmn:extensionElements>
    <bpmn:subProcess id="Activity_0wz4xd1" name="dependencies">
      <bpmn:task id="Activity_0n9lc1t" name="rust" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="stable toolchain, edition 2024" dai:package="https://www.rust-lang.org" dai:dependencyType="dev" dai:license="MIT OR Apache-2.0" dai:purpose="Implementation language and toolchain for the server." />
      <bpmn:task id="Activity_1nafjvj" name="pingora" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="latest stable release, pinned in Cargo.lock" dai:package="https://github.com/cloudflare/pingora" dai:dependencyType="runtime" dai:license="Apache-2.0" dai:purpose="HTTP proxy framework: listener, routing to upstreams, load balancing, streaming." />
      <bpmn:task id="Activity_09jmudl" name="sveltekit" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:notes="Built with adapter-static as a single-page app. The build output is embedded in the Rust binary and served by Moxy under /_app/*, so no Node.js runtime is needed. The UI gets all data from /api." dai:version="latest stable release, pinned in package-lock.json" dai:package="https://github.com/sveltejs/kit" dai:dependencyType="runtime" dai:license="MIT" dai:purpose="Builds the web UI for /, /chat and /admin." />
      <bpmn:task id="Activity_redb001" name="redb" dai:type="dai.types.software.dependency" dai:stepType="dependency" dai:version="latest stable release, pinned in Cargo.lock" dai:package="https://github.com/cberner/redb" dai:dependencyType="runtime" dai:license="MIT OR Apache-2.0" dai:purpose="Embedded key-value engine behind the KV Store." />
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_1mpy4pg" name="server">
      <bpmn:task id="Activity_0k3fev3" name="serve" dai:type="dai.types.software.service" dai:stepType="service" dai:notes="The single Moxy server process. Owns the route table, middleware pipeline, sessions, users, auth and cache.&#10;&#10;Startup sequence (in order):&#10;1. Read environment variables (see &#39;environment variables&#39;).&#10;2. Load and validate moxy.xml from $MOXY_CONFIG. If the file is missing or invalid, log the error and exit with a non-zero status.&#10;3. Open the KV store in $MOXY_DATA_DIR.&#10;4. Bind to the host and port from &#60;server host port&#62; in moxy.xml (default 127.0.0.1:8080).&#10;5. Start watching moxy.xml for changes.&#10;&#10;Shutdown: on SIGINT/SIGTERM stop accepting connections, let in-flight requests finish (max 30 s), close the KV store.&#10;&#10;All errors returned by Moxy itself (not by an upstream) use the JSON body {&#34;error&#34;: {&#34;type&#34;: &#34;&#60;snake_case_type&#62;&#34;, &#34;message&#34;: &#34;&#60;human readable&#62;&#34;}}." dai:version="0.2.0" dai:authType="api-key" dai:baseUrl="http://127.0.0.1:8080">
        <bpmn:incoming>Flow_02ybsg7</bpmn:incoming>
        <bpmn:incoming>Flow_0z4xe6m</bpmn:incoming>
        <bpmn:incoming>Flow_14awy32</bpmn:incoming>
        <bpmn:outgoing>Flow_0u8tt3y</bpmn:outgoing>
        <bpmn:outgoing>Flow_1fyzgyi</bpmn:outgoing>
        <bpmn:outgoing>Flow_1swv0ri</bpmn:outgoing>
        <bpmn:outgoing>Flow_1icwk2u</bpmn:outgoing>
        <bpmn:outgoing>Flow_1sfexq3</bpmn:outgoing>
        <bpmn:outgoing>Flow_1gm2pxl</bpmn:outgoing>
        <bpmn:outgoing>Flow_0hqw7el</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_0q42btx" name="moxy.xml&#10;(config)" dai:notes="The single source of truth for server configuration. Path: $MOXY_CONFIG (default ./moxy.xml). Format: Moxy Markup Language (MML), an XML vocabulary.&#10;&#10;Lifecycle:&#10;- Loaded on start; the server refuses to start if it is invalid.&#10;- Watched for changes. On change (debounced 500 ms) it is parsed and validated; if valid, the new config is swapped in atomically and new requests use it while in-flight requests finish on the old one. If invalid, the previous config stays active and the error is logged and shown in /admin.&#10;- /admin edits are written back to this file (validate, write temp file, atomic rename), which triggers the normal reload. Comments and formatting are not guaranteed to survive an /admin edit.&#10;&#10;Values of the form ${NAME} in any attribute are replaced with environment variable NAME at load time; a missing variable is a validation error.&#10;&#10;Schema (MML v1):&#10;&#60;moxy version=&#34;1&#34;&#62;&#10;  &#60;server host=&#34;127.0.0.1&#34; port=&#34;8080&#34; /&#62;&#10;  &#60;auth issuer=&#34;https://idp.example.com&#34; client-id=&#34;moxy&#34; client-secret=&#34;${MOXY_OIDC_CLIENT_SECRET}&#34; session-ttl=&#34;24h&#34;&#62;&#10;    &#60;admin email=&#34;admin@example.com&#34; /&#62;   (repeatable)&#10;  &#60;/auth&#62;&#10;  &#60;route path=&#34;/openai/*&#34; auth=&#34;api-key&#34; description=&#34;OpenAI models&#34;&#62;   (repeatable)&#10;    ...middleware elements, in execution order...&#10;    &#60;upstream url=&#34;https://api.openai.com/v1&#34; /&#62;   (or &#60;load-balance&#62;)&#10;  &#60;/route&#62;&#10;&#60;/moxy&#62;&#10;&#10;&#60;route&#62; attributes: path (required; literal prefix ending in /* or an exact path), auth = none | api-key | session (default api-key), description (shown on /).&#10;Validation errors: duplicate route path; a path under a reserved prefix (/chat, /admin, /auth, /api, /_app) or equal to /; a route with no &#60;upstream&#62; or &#60;load-balance&#62;; unknown element; unresolved ${NAME}.&#10;Middleware elements are defined on the &#39;Middleware&#39; node.">
        <bpmn:incoming>Flow_0u8tt3y</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_0dbscuo" name="model1 url" dai:notes="Example upstream: an AI model endpoint (e.g. an OpenAI-compatible API) declared with &#60;upstream url&#62; in moxy.xml. Upstreams are not fixed in code; any number can be configured.">
        <bpmn:incoming>Flow_06xjg42</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_0hb5etj" name="model2 url" dai:notes="Second example upstream, showing that one route can spread traffic across several model endpoints with &#60;load-balance&#62;, and that different routes can point at different models.">
        <bpmn:incoming>Flow_1ylgszp</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_1ukdryx" name="developer" dai:type="dai.types.product.persona" dai:stepType="persona" dai:role="Developer" dai:goals="Call models locally: reach every configured model from their own code through one local address, without each application knowing where each model is hosted." dai:behaviours="Uses existing SDKs pointed at a Moxy route, authenticating with a Moxy API key. Browses / to discover routes and uses /chat to try models.">
        <bpmn:outgoing>Flow_02ybsg7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_0m863ow" name="environment&#10;variables" dai:notes="Environment variables read at startup (changes require a restart):&#10;- MOXY_CONFIG: path to moxy.xml. Default ./moxy.xml.&#10;- MOXY_DATA_DIR: directory holding the KV store file. Default ./data (created if missing).&#10;- MOXY_LOG: log level (error | warn | info | debug | trace). Default info.&#10;&#10;Any other variable is only used when moxy.xml references it with ${NAME} (e.g. upstream API keys, the OIDC client secret). Environment variables never override moxy.xml implicitly; secrets must not be written literally into moxy.xml.">
        <bpmn:incoming>Flow_1fyzgyi</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_0naucbp" name="Middleware" dai:notes="Per-route middleware, declared as child elements of &#60;route&#62; in moxy.xml.&#10;&#10;Order: request-phase middleware runs in document order; response-phase middleware runs in reverse document order. The first middleware that rejects a request stops the pipeline and the upstream is not called.&#10;&#10;Elements by category:&#10;- headers: &#60;headers&#62; with &#60;set name value&#62;, &#60;add name value&#62; and &#60;remove name&#62; children. Applies to the upstream request; use inside &#60;response&#62; to change response headers.&#10;- request: &#60;request&#62; with &#60;rewrite-path from to&#62;, &#60;max-body-size bytes&#62; (413 if exceeded) and &#60;timeout duration&#62; (default 60s; 504 if exceeded).&#10;- response: &#60;response&#62; with &#60;set&#62;, &#60;add&#62; and &#60;remove&#62; header children, plus &#60;cache ttl&#62; (see &#39;Cache&#39;).&#10;- load balancing: &#60;load-balance strategy=&#34;round-robin | random | failover&#34;&#62; containing two or more &#60;upstream url&#62;. Used in place of a single &#60;upstream&#62;. An upstream that errors or times out is skipped for 30 s.&#10;- ai related: &#60;ai provider=&#34;openai | anthropic | ollama&#34; model=&#34;optional override&#34;&#62;. Parses provider request and response bodies so the model name can be rewritten and token usage counted. Required by &#60;token-budget&#62; and for a route to appear in /chat.&#10;- rate limit: &#60;rate-limit requests=&#34;N&#34; per=&#34;1s | 1m | 1h&#34; key=&#34;api-key | user | ip&#34;&#62;. Counters are kept in memory and reset on restart. Rejection: 429, Retry-After header, error type rate_limited.&#10;- token spend: &#60;token-budget tokens=&#34;N&#34; per=&#34;1h | 1d | 30d&#34; key=&#34;api-key | user&#34;&#62;. Usage is counted from upstream responses and stored in the KV store. A request is rejected once the budget for the current window is used up: 429, Retry-After header, error type token_budget_exceeded.&#10;&#10;Upstream errors: connection failure 502 (error type upstream_unavailable); timeout 504 (upstream_timeout). Upstream HTTP error responses are passed through unchanged.">
        <bpmn:incoming>Flow_1tvo624</bpmn:incoming>
        <bpmn:outgoing>Flow_1ylgszp</bpmn:outgoing>
        <bpmn:outgoing>Flow_06xjg42</bpmn:outgoing>
        <bpmn:outgoing>Flow_1342qoo</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_0x5p95d" name="admin" dai:type="dai.types.product.persona" dai:stepType="persona" dai:role="Administrator" dai:goals="Configure models locally: decide which routes exist, which upstreams they use, which middleware applies, and the server&#39;s system settings." dai:behaviours="Signs in through OIDC with an email listed in &#60;auth&#62;&#60;admin&#62;. Uses /admin or edits moxy.xml directly. Issues API keys to developers and agents.">
        <bpmn:outgoing>Flow_0z4xe6m</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_1e4qtf3" name="agent" dai:type="dai.types.product.persona" dai:stepType="persona" dai:role="Automated client (AI agent)" dai:goals="Call configured models programmatically through Moxy, within the rate limits and token budgets set for its API key." dai:behaviours="Has no browser and never uses OIDC. Authenticates with a Moxy API key issued by an admin and calls proxy routes and /api/endpoints.">
        <bpmn:outgoing>Flow_14awy32</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_00vb7qp" name="Routes" dai:notes="The route table. Each request is matched in this order:&#10;1. Built-in routes, which are reserved: / (exact), /chat and /chat/*, /admin and /admin/*, /auth/*, /api/*, and /_app/* (static UI assets).&#10;2. Proxy routes from moxy.xml, handled by /*. The longest matching path prefix wins; on a tie the route declared first in moxy.xml wins.&#10;3. No match: 404 {&#34;error&#34;: {&#34;type&#34;: &#34;route_not_found&#34;, ...}}.&#10;&#10;Role rules: &#39;user&#39; is anyone signed in through OIDC; &#39;admin&#39; is a user whose email is listed in &#60;auth&#62;&#60;admin email&#62;. Admins can do everything users can.">
        <bpmn:incoming>Flow_1swv0ri</bpmn:incoming>
        <bpmn:outgoing>Flow_0uqo3ue</bpmn:outgoing>
        <bpmn:outgoing>Flow_1c5pdvg</bpmn:outgoing>
        <bpmn:outgoing>Flow_1isgm00</bpmn:outgoing>
        <bpmn:outgoing>Flow_0xxjho7</bpmn:outgoing>
        <bpmn:outgoing>Flow_0w6stqi</bpmn:outgoing>
        <bpmn:outgoing>Flow_03l40s5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_06nppal" name="/admin" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Browser admin UI (SvelteKit) for configuring the server. Requires role admin; signed-in non-admins get 403, anonymous callers are redirected to /auth/login?return_to=/admin.&#10;&#10;Functions:&#10;- Edit routes (add, change, delete proxy routes and their upstreams).&#10;- Edit system settings (&#60;server&#62; and &#60;auth&#62;).&#10;- Edit middleware configuration for each route.&#10;- Create, list and revoke API keys.&#10;- Show the active config version and the last reload error, if any.&#10;&#10;Every config change is written back to moxy.xml (see &#39;moxy.xml (config)&#39;); nothing is configured only in the KV store except API keys." dai:method="GET" dai:path="/admin" dai:authType="oauth2" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">serve</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1c5pdvg</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_1xahufv" name="/*" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="The proxy path. Handles every request that is not a built-in route and matches a &#60;route path&#62; in moxy.xml (see &#39;Routes&#39; for matching).&#10;&#10;Per request:&#10;1. Authenticate according to the route&#39;s auth attribute: none; api-key (Authorization: Bearer &#60;moxy API key&#62;, the default); or session (cookie). Failure gives 401. The caller&#39;s Authorization header and Moxy session cookie are always removed before forwarding; upstream credentials are added by header middleware.&#10;2. Run the route&#39;s middleware (see &#39;Middleware&#39;).&#10;3. Forward to the upstream. The part of the path matched by * is appended to the upstream URL, and the query string is kept (e.g. route /openai/* with upstream https://api.openai.com/v1 maps /openai/chat/completions to https://api.openai.com/v1/chat/completions).&#10;4. Stream the response back through the response phase of the middleware.&#10;All HTTP methods are proxied. Streaming responses (SSE, chunked) are passed through without buffering." dai:path="/*" dai:authType="api-key">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">serve</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0uqo3ue</bpmn:incoming>
        <bpmn:outgoing>Flow_1tvo624</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_1ceywrr" name="/ (anon)" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Anonymous HTML page (SvelteKit) that lists the proxy routes in the current moxy.xml: path, description and auth mode. Upstream URLs, headers and credentials are never shown. The same data is available as JSON from GET /api/endpoints." dai:method="GET" dai:path="/" dai:authType="none" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">serve</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1isgm00</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_1kjuls9" name="/chat" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Browser chat UI (SvelteKit) for talking to configured models. Requires a signed-in session (role user or admin); without one it redirects (302) to /auth/login?return_to=/chat.&#10;&#10;The model picker lists every proxy route that contains an &#60;ai&#62; middleware element. Messages are sent with POST /api/chat, which runs the request through that route&#39;s full middleware pipeline (so rate limits and token budgets apply to the signed-in user) and streams the reply back using server-sent events. Chat history is held in the browser only; it is not stored on the server." dai:method="GET" dai:path="/chat" dai:authType="oauth2" dai:statusCode="200">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">serve</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0xxjho7</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_1j6oxqe" name="any url" dai:notes="Any http(s) URL, not just AI models: Moxy also works as a general-purpose reverse proxy. AI-specific middleware (&#60;ai&#62;, &#60;token-budget&#62;) is simply not configured on such routes.">
        <bpmn:incoming>Flow_1342qoo</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_0h0h53q" name="Session" dai:type="dai.types.software.model" dai:stepType="model" dai:notes="Server-side session for a signed-in browser user.&#10;KV key: session#&#60;id&#62;, where id is 32 random bytes, base64url-encoded.&#10;Cookie: moxy_session=&#60;id&#62;; HttpOnly; SameSite=Lax; Path=/; Secure unless the server is bound to 127.0.0.1/localhost.&#10;Lifetime: &#60;auth session-ttl&#62; (default 24h), sliding. Every authenticated request more than 1 h after the last refresh extends expiresAt." dai:modelFormat="plain">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="id" type="str" />
            <dai:property name="userSub" type="str" />
            <dai:property name="csrfToken" type="str" />
            <dai:property name="createdAt" type="datetime" />
            <dai:property name="expiresAt" type="datetime" />
          </dai:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1icwk2u</bpmn:incoming>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_0x8hzsn">
          <bpmn:targetRef>DataStoreReference_0h9ku2u</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:task id="Activity_06ixee5" name="Users" dai:type="dai.types.software.model" dai:stepType="model" dai:notes="One record per person who has signed in through OIDC. Created on first login, updated on every login.&#10;KV key: user#&#60;sub&#62;, where sub is the OIDC subject claim.&#10;role is computed at login from &#60;auth&#62;&#60;admin email&#62; and stored; a config change takes effect at the user&#39;s next request (role is re-checked against the current config on each request)." dai:modelFormat="plain">
        <bpmn:extensionElements>
          <dai:properties>
            <dai:property name="sub" type="str" />
            <dai:property name="email" type="str" />
            <dai:property name="name" type="str" />
            <dai:property name="role" type="str" />
            <dai:property name="createdAt" type="datetime" />
            <dai:property name="lastLoginAt" type="datetime" />
          </dai:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1sfexq3</bpmn:incoming>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_0oqokug">
          <bpmn:targetRef>DataStoreReference_0h9ku2u</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:task id="Activity_107p1xs" name="/api" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="Moxy&#39;s own JSON API, used by the SvelteKit UI and by scripts. It is not the model proxy (model traffic goes through /*).&#10;&#10;Authentication: session cookie (browser) or Authorization: Bearer &#60;moxy API key&#62;. Endpoints:&#10;- GET /api/endpoints: anonymous. Same data as /.&#10;- GET /api/me: user. Current identity and role.&#10;- POST /api/chat: user. Body {&#34;route&#34;: &#34;&#60;route path&#62;&#34;, &#34;messages&#34;: [...]}; streams the reply as server-sent events.&#10;- GET /api/config: admin. Current config as JSON.&#10;- PUT /api/config/routes, PUT /api/config/settings, PUT /api/config/routes/{path}/middleware: admin. Validate, then write moxy.xml. Invalid input gives 422 with the validation errors.&#10;- GET /api/keys, POST /api/keys, DELETE /api/keys/{id}: admin. The plaintext key is returned only once, by POST.&#10;Missing credentials give 401; insufficient role gives 403. State-changing calls made with a session cookie must send the X-CSRF-Token header with the session&#39;s csrf token." dai:path="/api/*" dai:authType="bearer">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">serve</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0w6stqi</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_12436hi" name="Auth" dai:notes="OpenID Connect integration plus Moxy API keys. Configured by &#60;auth&#62; in moxy.xml.&#10;Records written to the KV store:&#10;- auth#state#&#60;state&#62;: {nonce, pkceVerifier, returnTo, expiresAt}. Created by /auth/login, deleted on callback, expires after 10 min.&#10;- apikey#&#60;sha256 of key&#62;: {id, name, ownerSub, createdAt, lastUsedAt, revoked}. Keys look like moxy_&#60;32 random base64url chars&#62;; only the hash is stored.&#10;API keys are for programmatic callers (developers&#39; code, AI agents). Each key belongs to the user who created it (an admin), and per-key rate limits and token budgets use it as the key.">
        <bpmn:incoming>Flow_1gm2pxl</bpmn:incoming>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_1c50yck">
          <bpmn:targetRef>DataStoreReference_0h9ku2u</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:task id="Activity_19uonmy" name="/auth" dai:type="dai.types.software.api-endpoint" dai:stepType="api-endpoint" dai:notes="OpenID Connect login flow (authorization code flow with PKCE):&#10;- GET /auth/login?return_to=&#60;path&#62;: creates a login-state record and redirects (302) to the OIDC provider.&#10;- GET /auth/callback: validates state and nonce, exchanges the code, creates or updates the user record, creates a session, sets the session cookie, and redirects to return_to (default /). Invalid or expired state gives 400.&#10;- POST /auth/logout: deletes the session, clears the cookie, redirects to /.&#10;Only same-origin relative paths are accepted for return_to." dai:path="/auth/*" dai:authType="none">
        <bpmn:extensionElements>
          <dai:fields>
            <dai:field key="service">serve</dai:field>
          </dai:fields>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_03l40s5</bpmn:incoming>
      </bpmn:task>
      <bpmn:task id="Activity_0z98u12" name="Cache" dai:notes="Optional response cache, enabled per route with &#60;cache ttl=&#34;5m&#34; /&#62; inside &#60;response&#62;. Off by default.&#10;Cached: 200 responses to GET requests, and to POST requests on routes that have &#60;ai&#62;, where the response is not streamed.&#10;Not cached: streamed responses, requests with Cache-Control: no-cache, and responses with Cache-Control: no-store or private.&#10;KV key: cache#&#60;sha256 of route path + method + upstream URL + normalised body + caller key&#62;. The caller (API key or user) is part of the key, so one caller never receives another caller&#39;s cached response.&#10;Entries expire after ttl. All entries for a route are dropped when that route changes in moxy.xml.">
        <bpmn:incoming>Flow_0hqw7el</bpmn:incoming>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_099ercj">
          <bpmn:targetRef>DataStoreReference_0h9ku2u</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:task>
      <bpmn:dataStoreReference id="DataStoreReference_0h9ku2u" name="KV Store" dai:notes="The single persistent store for all Moxy state. An embedded key-value store (redb) in one file, $MOXY_DATA_DIR/moxy.redb, accessed through a KvStore trait so the engine can be replaced.&#10;Single Table Design: one table; entity type is the key prefix:&#10;- user#&#60;sub&#62;&#10;- session#&#60;id&#62;&#10;- auth#state#&#60;state&#62;&#10;- apikey#&#60;sha256&#62;&#10;- cache#&#60;sha256&#62;&#10;- usage#&#60;api-key id | user sub&#62;#&#60;route path&#62;#&#60;window start&#62; (token-budget counters)&#10;Every value is JSON and carries an optional expiresAt. Expired entries are ignored on read and deleted by a sweep every 10 min.&#10;Rate-limit counters are in memory and are not stored here." />
      <bpmn:sequenceFlow id="Flow_02ybsg7" sourceRef="Activity_1ukdryx" targetRef="Activity_0k3fev3" />
      <bpmn:sequenceFlow id="Flow_0z4xe6m" sourceRef="Activity_0x5p95d" targetRef="Activity_0k3fev3" />
