      <bpmn:textAnnotation id="TextAnnotation_0ahmac8">
        <bpmn:text>Categories of middleware to manipulate requests and responses
- headers
- request
- response (incl. cache)
- load balancing
- ai related
- rate limit
- token spend
(Elements and behaviour: see the Middleware node's notes.)</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="Association_0ptj8ma" associationDirection="None" sourceRef="Activity_0naucbp" targetRef="TextAnnotation_0ahmac8" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Group_decisions" name="decisions" dai:notes="Architecture decisions that resolve ambiguities found in v0.1.0 of this spec. Status proposed = taken while clarifying the spec and awaiting the owner&#39;s confirmation.">
      <bpmn:task id="Decision_std" name="Single Table Design" dai:type="dai.types.software.decision" dai:status="accepted" dai:context="v0.1.0 listed Single Table Design as a dependency, but it is a data-modelling pattern, not a package." dai:decision="All entities share one KV table and are distinguished by typed key prefixes (user#, session#, auth#, apikey#, cache#, usage#)." dai:consequences="One storage abstraction and one file to back up. Key formats are part of the contract and need migration if changed." />
      <bpmn:task id="Decision_cfgfile" name="Config file is moxy.xml" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 referred to the config as moxy.xml, config.yaml and config.yml in different places." dai:decision="There is exactly one config file, moxy.xml, in Moxy Markup Language. The port, routes, middleware, auth and system settings all live there." dai:consequences="No YAML support. Every reference to config.yaml or config.yml means moxy.xml." />
      <bpmn:task id="Decision_kv" name="Embedded KV engine" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 named a &#39;KV Store&#39; but no product. Moxy runs locally as a single process." dai:decision="Use redb, an embedded Rust KV store, in one file under $MOXY_DATA_DIR, behind a KvStore trait." dai:consequences="No external database to run. Single-node only; running several Moxy instances against the same store is not supported." />
      <bpmn:task id="Decision_adminwrite" name="/admin persists to moxy.xml" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 did not say whether /admin changes are written back to moxy.xml or stored elsewhere." dai:decision="/admin and /api write moxy.xml atomically; the file watcher then reloads it. moxy.xml stays the single source of truth. API keys are the only admin-managed data kept in the KV store." dai:consequences="Hand edits and UI edits never diverge. Comments and formatting in moxy.xml may be lost after a UI edit." />
      <bpmn:task id="Decision_routing" name="Route matching" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 did not say how a catch-all request is mapped to an upstream, or how built-in and proxy routes interact." dai:decision="Built-in prefixes are reserved and checked first. Proxy routes match by longest prefix, then by declaration order. The suffix matched by * is appended to the upstream URL." dai:consequences="Proxy routes cannot use /, /chat, /admin, /auth, /api or /_app. This is enforced at config validation." />
      <bpmn:task id="Decision_mw" name="Middleware order and rejection" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 named seven middleware categories but not the elements, their order, or how rejections look." dai:decision="Request phase runs in document order and response phase in reverse. Rejections use fixed status codes (401, 413, 429 + Retry-After, 502, 504) and a JSON error body." dai:consequences="Callers can handle Moxy errors programmatically. The element set is v1 and can be extended." />
      <bpmn:task id="Decision_authz" name="Roles and API keys" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 did not say which routes require auth, what roles exist, how someone becomes admin, or how non-browser callers authenticate." dai:decision="Two roles: user (any OIDC sign-in) and admin (email listed in &#60;auth&#62;&#60;admin&#62;). / is anonymous, /chat needs user, /admin needs admin, /api is per endpoint, and proxy routes are per-route (default api-key). Programmatic callers use admin-issued API keys sent as Bearer tokens." dai:consequences="Admin rights are controlled in config, not in the UI. Existing OpenAI-style SDKs work unchanged by setting their API key to a Moxy key." />
      <bpmn:task id="Decision_ui" name="SvelteKit served by Moxy" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 listed SvelteKit without saying which pages it renders or how it runs next to a Rust server." dai:decision="SvelteKit (adapter-static) builds /, /chat and /admin as a single-page app. The assets are embedded in the binary and served under /_app/*. Data comes from /api." dai:consequences="One binary, no Node.js at runtime. No server-side rendering." />
      <bpmn:task id="Decision_env" name="Env vars vs config" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 did not list environment variables or say how they relate to moxy.xml." dai:decision="Only MOXY_CONFIG, MOXY_DATA_DIR and MOXY_LOG are read directly. Everything else comes from explicit ${NAME} references in moxy.xml." dai:consequences="Secrets stay out of the config file and there are no hidden overrides." />
      <bpmn:task id="Decision_cache" name="Cache policy" dai:type="dai.types.software.decision" dai:status="proposed" dai:context="v0.1.0 had a cache with no stated contents, keys or expiry." dai:decision="Opt-in per-route response cache (&#60;cache ttl&#62;), keyed by request and caller, for non-streamed 200 responses only." dai:consequences="No surprise caching of model output. Cache entries are never shared between callers." />
    </bpmn:subProcess>
    <bpmn:subProcess id="Group_assumptions" name="assumptions" dai:notes="Readings of the original author&#39;s intent that this spec depends on. Each is unvalidated until the owner confirms it.">
      <bpmn:task id="Assumption_agent" name="Agent persona is an automated client" dai:type="dai.types.business.assumption" dai:stepType="assumption" dai:status="unvalidated" dai:basis="v0.1.0 names the persona and connects it to serve, but gives it no role or goals." dai:ifWrong="If agents are meant to be AI agents hosted inside Moxy, an agent runtime would need to be specified." />
      <bpmn:task id="Assumption_authnotes" name="/auth notes were a copy error" dai:type="dai.types.business.assumption" dai:stepType="assumption" dai:status="unvalidated" dai:basis="In v0.1.0 the /auth notes were identical to the /admin notes, and Auth uses OpenID Connect." dai:ifWrong="If /auth was meant to configure auth providers, that function belongs in /admin settings." />
      <bpmn:task id="Assumption_models" name="model1/model2 are examples" dai:type="dai.types.business.assumption" dai:stepType="assumption" dai:status="unvalidated" dai:basis="v0.1.0 shows two hard-coded model URL nodes, and &#39;any url&#39; is also forwarded." dai:ifWrong="If exactly two fixed model upstreams were intended, the config schema could be simpler." />
      <bpmn:task id="Assumption_api" name="/api is Moxy&#39;s management API" dai:type="dai.types.business.assumption" dai:stepType="assumption" dai:status="unvalidated" dai:basis="v0.1.0 defines /api with no description. Model traffic already has the /* proxy path, and the SvelteKit UI needs a data API." dai:ifWrong="If /api was meant to be a unified model API (e.g. OpenAI-compatible), it would overlap with proxy routes and needs a separate design." />
    </bpmn:subProcess>
    <bpmn:textAnnotation id="TextAnnotation_1kknaxa">
      <bpmn:text>Moxy Markup Language (XML)
Compose a server configuration using XML elements.
(Schema: see the moxy.xml node's notes.)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1m5q5fc" associationDirection="None" sourceRef="Activity_0q42btx" targetRef="TextAnnotation_1kknaxa" />
  </bpmn:process>
